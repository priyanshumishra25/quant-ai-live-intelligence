# Local development defaults. Copy to .env; never commit .env.
ENV=development
LOG_LEVEL=INFO

# Offline/reproducible research path.
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_PREDICTIONS=300
REDIS_TTL_INTELLIGENCE=1800
# Provider-level caches preserve the scarce free Alpha Vantage quota even when
# the user changes forecast horizon or refreshes the UI.
REDIS_TTL_SYMBOL_RESOLUTION=604800
REDIS_TTL_MARKET_HISTORY=21600
REDIS_TTL_NEWS=1800
REDIS_TTL_REDDIT=600
MARKET_DATA_PROVIDER=bundled
SAMPLE_DATA_DIR=data/sample
MODEL_ARTIFACT_DIR=artifacts/models
DEFAULT_HORIZON=5d

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
AUTH_REQUIRED=true
AUTH_USERNAME=demo
AUTH_PASSWORD=quantai-demo
JWT_SECRET=development-only-change-me-please-32-bytes
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# ── Live Intelligence ──────────────────────────────────────────────────────
# Required for arbitrary-stock resolution, historical OHLCV and market news.
# Get a key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=
# Free keys should remain on compact. Alpha Vantage documents full daily history
# as premium-only; compact supplies the latest 100 daily bars.
ALPHA_VANTAGE_OUTPUTSIZE=compact
# Free-tier pacing: keep sequential Alpha Vantage calls just over one second apart.
ALPHA_VANTAGE_MIN_INTERVAL_SECONDS=1.10

# Optional but required for Reddit evidence. Use authorised Reddit Data API
# credentials for a read-only app and a descriptive user agent.
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=QuantAIResearch/3.0 by-your-reddit-username

# Retrieval budgets. The model uses all returned evidence; the UI only shows a
# compact attributed subset. Provider plan/rate limits still apply.
INTELLIGENCE_LOOKBACK_DAYS=365
INTELLIGENCE_NEWS_LIMIT=500
INTELLIGENCE_REDDIT_LIMIT=100
INTELLIGENCE_REDDIT_COMMENT_POSTS=5
INTELLIGENCE_REDDIT_COMMENTS_PER_POST=20

# Retained optional research providers; not required for the default product.
POLYGON_KEY=
NEWSAPI_KEY=
